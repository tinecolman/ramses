const S = DATA.stats;

/* ---------- review state ---------- */
let db = null, reviews = Object.create(null);
function docId(t){
  let h=5381; for(let i=0;i<t.length;i++) h=((h<<5)+h+t.charCodeAt(i))>>>0;
  return t.replace(/[^A-Za-z0-9_.\-~:@+]/g,"_").slice(0,170)+"_"+h.toString(36);
}
function isFlagged(t){ const r=reviews[t]; return !!(r&&r.status==="flag"); }
function noteOf(t){ const r=reviews[t]; return (r&&r.note)||""; }

async function saveReview(t,status,note){
  reviews[t]={target:t,status,note:note||""};
  if(!db) return false;
  try{
    await db.collection("review").doc(docId(t)).set(
      {target:t,status,note:note||"",at:Date.now()});
    return true;
  }catch(e){ dbMsg("Could not save that flag ("+(e&&e.code||"unknown")+"). It is kept for this browser session only."); return false; }
}
function dbMsg(m){ const n=document.getElementById("dbnote"); n.innerHTML="<b>Note</b> "+m; n.hidden=false; }

/* ---------- helpers ---------- */
function cls(v){
  if(v==null) return "unset";
  const s=String(v).trim().toLowerCase();
  if(!s) return "unset";
  if(s==="yes") return "ok";
  if(s==="no") return "bad";
  if(s==="-"||s==="n/a") return "na";
  if(s.indexOf("openmp_")===0) return "branch";
  return "wip";
}
const esc = s => String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

/* ---------- collapse state ---------- */
/* Per-viewer only: the page must render correctly when storage throws or is
   empty, so every access is guarded and the default is "everything closed". */
const OPENKEY="ramses-inventory-open", QSKEY="ramses-inventory-review-open";
let opened=(function(){
  try{ const v=localStorage.getItem(OPENKEY);
       if(v) return new Set(JSON.parse(v)); }catch(e){}
  return new Set();
})();
function saveOpen(){ try{ localStorage.setItem(OPENKEY,JSON.stringify([...opened])); }catch(e){} }
const fkey=f=>"f:"+f.id, akey=(f,a)=>"a:"+f.id+"/"+a.id;
let shut=new Set();          /* closed by hand while a filter is narrowing */
function setOpen(k,on){ on?opened.add(k):opened.delete(k); saveOpen(); }
function openNow(k){ return filtering() ? !shut.has(k) : opened.has(k); }

/* ---------- which tests reach which routines ---------- */
const TM=DATA.tests_by_routine||{names:[],paths:[],routines:{}};
const TESTIDX={}; TM.names.forEach((n,i)=>{TESTIDX[n]=i;});
function testsOf(r){
  const v=TM.routines[r.file+"::"+r.name];
  return v?v.map(i=>TM.paths[i]||TM.names[i]):[];
}
function reachedBy(r,i){
  const v=TM.routines[r.file+"::"+r.name];
  return !!v && v.indexOf(i)>=0;
}

/* ---------- filters ---------- */
const filt={q:"",omp:"all",cov:"all",phase:"all",view:"all",scope:"all",test:""};
function filtering(){
  return !!filt.q || !!filt.test || filt.omp!=="all" || filt.cov!=="all"
      || filt.phase!=="all" || filt.view!=="all" || filt.scope!=="all";
}
function match(r,f,a){
  if(filt.test){
    const i=TESTIDX[filt.test];
    if(i===undefined || !reachedBy(r,i)) return false;
  }
  /* under review can be marked on the routine, its area or its whole feature */
  if(filt.view==="review" && !(r.review||a.review||f.review)) return false;
  if(filt.cov!=="all"){
    const c=r.coverage||{};
    if(filt.cov==="na"){ if(c.pct!=null) return false; }
    else if(c.pct==null) return false;
    else if(filt.cov==="none"){ if(c.pct>0) return false; }
    else if(filt.cov==="low"){ if(c.pct>=50) return false; }
    else if(filt.cov==="full"){ if(c.pct<100) return false; }
  }
  if(filt.omp!=="all"){
    const o=r.omp||{};
    if(filt.omp==="gap"){ if(o.progress!=="todo") return false; }
    else if(filt.omp==="disagrees"){ if(!o.disagrees) return false; }
    else if(o.state!==filt.omp) return false;
  }
  if(filt.phase!=="all" && r.phase!==filt.phase) return false;
  if(filt.view==="flagged" && !isFlagged("routine:"+r.file+"::"+r.name)) return false;
  if(filt.view==="drivers" && !r.driver) return false;
  if(filt.view==="private" && r.role!=="private") return false;
  if(filt.view==="unused" && r.role!=="unused") return false;
  if(filt.view==="todo" && !r.todo) return false;
  if(filt.scope!=="all" && r.scope!==filt.scope) return false;
  if(filt.q){
    const h=(r.name+" "+r.file+" "+f.id+" "+f.title+" "+a.id+" "+a.title).toLowerCase();
    if(h.indexOf(filt.q)<0) return false;
  }
  return true;
}

/* ---------- routine-level chips ---------- */
function scopeTitle(r){
  return {area:"every caller is in this area",
          feature:"callers span areas, but stay inside this feature",
          global:"callers span more than one feature"}[r.scope]||"";
}
function roleTitle(r){
  const d=r.depth==null?"not reached from the program entry point"
                       :"call depth "+r.depth+" from the program entry point";
  if(r.role==="unused") return "never referenced anywhere in the tree";
  if(!r.callers||!r.callers.length) return d+" \u00b7 no caller found";
  const c=r.callers;
  return d+" \u00b7 called by "+(c.length>10?c.slice(0,10).join(", ")+" and "+(c.length-10)+" more":c.join(", "));
}
const OMPTIP={
  opens_region:"opens an OpenMP parallel region \u2014 threading starts here",
  adapted:"runs inside someone else's region and was changed for it",
  stateless:"runs inside a region and needed no change: keeps nothing between calls",
  race:"runs inside a region but keeps written state between calls",
  unthreaded:"never runs inside a parallel region"};
const OMPSHORT={opens_region:"region",adapted:"adapted",stateless:"stateless",
                race:"race",unthreaded:"unthreaded"};
function ompChip(r){
  const o=r.omp; if(!o) return '<span></span>';
  let tip=(OMPTIP[o.state]||o.state);
  if(o.regions) tip+=" \u00b7 "+o.regions+" region"+(o.regions>1?"s":"");
  if(o.threadprivate) tip+=" \u00b7 "+o.threadprivate+" threadprivate";
  if(o.sync) tip+=" \u00b7 "+o.sync+" critical/atomic";
  if(o.unprotected) tip+=" \u00b7 unprotected: "+o.unprotected.join(", ");
  if(o.na) tip+=" \u00b7 not needed: "+o.na;
  if(o.recorded) tip+=" \u00b7 spreadsheet said \u201c"+o.recorded+"\u201d";
  if(o.progress==="todo") tip+=" \u2014 counts as a gap";
  if(o.progress==="na")   tip+=" \u2014 outside the OpenMP scope";
  return '<span class="omp'+(o.progress==="na"?" na":"")+'" data-s="'+esc(o.state)+
         '" data-p="'+esc(o.progress||"")+'" title="'+esc(tip)+'">'+esc(OMPSHORT[o.state]||o.state)+'</span>';
}
function covLevel(p){
  return p==null?"na":p===0?"none":p<50?"low":p<85?"mid":p<100?"high":"full";
}
/* coverage and benchmark share a shape, so they share a chip and a bar */
function lineChip(key,what){ return function(r){
  const c=r[key];
  if(!c) return '<span class="cov" data-l="na" title="not recorded yet">\u2013</span>';
  if(c.pct==null){
    const why=c.na||(c.status==="not_measured"
      ?"no "+what+" data: this file is built without the coverage flags"
      :"no executable lines of its own");
    return '<span class="cov" data-l="na" title="'+esc(why)+'">\u2013</span>';
  }
  let tip=c.covered+" of "+c.total+" of its own lines ran under "+what;
  if(c.notbuilt) tip+=" \u00b7 "+c.notbuilt+" behind a preprocessor directive no build enabled";
  if(c.benchmarks) tip+=" \u00b7 "+c.benchmarks.join(", ");
  if(key==="coverage"){
    const ts=testsOf(r);
    tip+=ts.length?" \u00b7 reached by "+ts.length+" test"+(ts.length>1?"s":"")+": "+
         (ts.length>12?ts.slice(0,12).join(", ")+" and "+(ts.length-12)+" more":ts.join(", "))
        :" \u00b7 no test reaches it";
  }
  tip+=" \u00b7 lines of contained routines are charged to those routines";
  return '<span class="cov" data-l="'+covLevel(c.pct)+'" title="'+esc(tip)+'">'+
         Math.round(c.pct)+'%</span>';
};}
function lineTally(key){ return function(list){
  let cov=0,tot=0,nb=0,na=0;
  list.forEach(r=>{const c=r[key]||{};
    if(c.pct==null){na++;return;}
    cov+=c.covered; tot+=c.total; nb+=c.notbuilt||0;});
  return {cov:cov,tot:tot,nb:nb,na:na,pct:tot?Math.round(100*cov/tot):null};
};}
function lineBar(key,what){ const t=lineTally(key); return function(list){
  const s=t(list);
  if(s.pct==null) return '<span class="prog" title="no '+what+' data here">'+
    '<span class="pbar"></span><span class="pct">n/a</span></span>';
  const c=Math.round(100*s.cov/s.tot);
  return '<span class="prog" title="'+what+' '+s.cov+' of '+s.tot+' lines'+
    (s.nb?", "+s.nb+" never built":"")+(s.na?", "+s.na+" routines not measured":"")+
    '"><span class="pbar"><i class="c" style="width:'+c+'%"></i>'+
    '<i class="u" style="width:'+(100-c)+'%"></i></span>'+
    '<span class="pct" data-l="'+covLevel(s.pct)+'">'+s.pct+'%</span></span>';
};}
const DOCSHORT={documented:"doc",partial:"part",undocumented:"none"};
function docsChip(r){
  const d=r.docs;
  if(!d||!d.state) return '<span class="docs" data-l="na" title="not recorded yet">\u2013</span>';
  let tip=d.note||d.state;
  if(d.lecture) tip+=" \u00b7 "+d.lecture;
  return '<span class="docs" data-l="'+esc(d.state)+'" title="'+esc(tip)+'">'+
         esc(DOCSHORT[d.state]||d.state)+'</span>';
}
function docsTally(list){
  let ok=0,part=0,no=0,na=0;
  list.forEach(r=>{const st=(r.docs||{}).state;
    if(st==="documented")ok++; else if(st==="partial")part++;
    else if(st==="undocumented")no++; else na++;});
  const need=ok+part+no;
  return {ok:ok,part:part,no:no,na:na,need:need,
          pct:need?Math.round(100*ok/need):null};
}
function docsBar(list){
  const s=docsTally(list);
  if(!s.need) return '<span class="prog" title="no documentation data here">'+
    '<span class="pbar"></span><span class="pct">n/a</span></span>';
  const d=Math.round(100*s.ok/s.need), pt=Math.round(100*s.part/s.need);
  return '<span class="prog" title="'+s.ok+' documented, '+s.part+' partial, '+
    s.no+' undocumented'+(s.na?", "+s.na+" not recorded":"")+'">'+
    '<span class="pbar"><i class="d" style="width:'+d+'%"></i>'+
    '<i class="t" style="width:'+pt+'%"></i>'+
    '<i class="u" style="width:'+(100-d-pt)+'%"></i></span>'+
    '<span class="pct" data-l="'+(s.pct===100?"full":s.pct===0?"none":"mid")+'">'+
    s.pct+'%</span></span>';
}
function tally(list){
  let done=0,todo=0,na=0;
  list.forEach(r=>{const p=r.omp&&r.omp.progress;
    if(p==="done")done++; else if(p==="todo")todo++; else na++;});
  return {done:done,todo:todo,na:na,need:done+todo,
          pct:(done+todo)?Math.round(100*done/(done+todo)):null};
}
function progBar(list){
  const s=tally(list);
  if(s.need===0) return '<span class="prog" title="no routine here needs OpenMP">'+
    '<span class="pbar"></span><span class="pct">n/a</span></span>';
  const d=Math.round(100*s.done/s.need);
  const lvl=s.pct===100?"full":s.pct===0?"none":"part";
  return '<span class="prog" title="'+s.done+' of '+s.need+' done, '+s.todo+
    ' to do'+(s.na?", "+s.na+" outside OpenMP scope":"")+'">'+
    '<span class="pbar"><i class="d" style="width:'+d+'%"></i>'+
    '<i class="t" style="width:'+(100-d)+'%"></i></span>'+
    '<span class="pct" data-l="'+lvl+'">'+s.pct+'%</span></span>';
}

/* ---------- the status dimensions ----------
   One entry per thing we track about a routine. A dimension whose key has no
   data anywhere in the inventory is not rendered at all: no column, no header
   bar, no legend entry. Adding a fifth dimension is one entry here plus a
   `key` block on the routines in inventory.yaml. */
const DIMS=[
  {key:"omp",       label:"openmp",    width:"90px", chip:ompChip,
   bar:progBar},
  {key:"coverage",  label:"coverage",  width:"60px", chip:lineChip("coverage","tests"),
   bar:lineBar("coverage","coverage")},
  {key:"benchmark", label:"benchmarks",width:"60px", chip:lineChip("benchmark","benchmarks"),
   bar:lineBar("benchmark","benchmarks")},
  {key:"docs",      label:"docs",      width:"60px", chip:docsChip,
   bar:docsBar}
];
const ALLR=[];
DATA.features.forEach(f=>f.areas.forEach(a=>a.routines.forEach(r=>ALLR.push(r))));
const DIM=DIMS.filter(d=>ALLR.some(r=>r[d.key]&&Object.keys(r[d.key]).length));
const ROWCOLS="26px minmax(150px,1.15fr) minmax(140px,1.15fr) 58px 28px 58px 72px "+
              DIM.map(d=>d.width).join(" ");
function bars(list){
  return '<span class="bars">'+DIM.map(d=>'<span class="dim"><u>'+d.label+'</u>'+
         d.bar(list)+'</span>').join("")+'</span>';
}

/* ---------- render ---------- */
function figures(){
  const flagged=Object.values(reviews).filter(r=>r.status==="flag").length;
  document.getElementById("figures").innerHTML=[
    ["routines",S.routines],["features",S.features],["areas",S.areas],
    ["source files",S.files],["amr_step drivers",S.drivers],
    ["cross-feature calls",S.edges],["tests",S.tests==null?"\u2013":S.tests],
    ["openmp done",S.done+" / "+S.need],
    ["gaps",S.todo],["races",S.unsafe],
    ["coverage",S.cov_pct+"%"],["uncovered routines",S.cov_zero],
    ["flagged",flagged]
  ].map(([l,v])=>'<div class="fig"><b>'+v+'</b><span>'+l+'</span></div>').join("");
}

function allRoutines(f){const o=[];f.areas.forEach(a=>a.routines.forEach(r=>o.push(r)));return o;}

function rail(){
  const el=document.getElementById("rail");
  let h='<h2>Features</h2>';
  DATA.features.forEach(f=>{
    const rl=allRoutines(f), s=tally(rl), pct=s.pct==null?0:s.pct;
    h+='<a class="rl" href="#f-'+f.id+'"><span class="nm">'+f.id+'</span>'+
       '<span class="ct">'+rl.length+'</span>'+
       '<span class="bar"><i style="width:'+pct+'%"></i></span></a>';
  });
  el.innerHTML=h;
}

const FTITLE={};
DATA.features.forEach(f=>{ FTITLE[f.id]=f.title; });
function deps(f){
  const line=(label,list,tip)=>{
    if(!list||!list.length) return "";
    return '<b title="'+esc(tip)+'">'+label+'</b><span>'+
      list.slice(0,7).map(([id,n])=>'<em title="'+esc(FTITLE[id]||id)+'">'+esc(id)+
        '</em> <i>\u00b7'+n+'</i>').join("  ")+
      (list.length>7?' <i>and '+(list.length-7)+' more</i>':"")+'</span>';
  };
  const h=line("used by",f.used_by,"features whose routines call into this one, and how many call sites")+
          line("uses",f.uses,"features this one calls into, and how many call sites");
  return h?'<span class="deps">'+h+'</span>':"";
}

function revChip(o,what){
  if(!o.review) return "";
  return ' <span class="rev" title="'+esc(what+": "+o.review)+'">review</span>';
}

function lectureLink(f){
  const lec=f.lecture||"none";
  if(lec==="none") return '<span class="lec gap" title="no developer lecture covers '+
    esc(f.id)+' yet">no lecture</span>';
  return lec.split(" ").map(n=>'<a class="lec" target="_blank" rel="noopener" href='+
    '"https://ramses-organisation.readthedocs.io/en/latest/dev_docs/lecture/'+
    encodeURIComponent(n.replace(/\.rst$/,""))+'.html">'+esc(n)+'</a>').join(" ");
}

function render(){
  const main=document.getElementById("main");
  main.style.setProperty("--rowcols",ROWCOLS);
  let out=questions();
  const blocks=[];
  DATA.features.forEach(f=>{
    const areas=[];
    f.areas.forEach(a=>{
      const rs=a.routines.filter(r=>match(r,f,a));
      if(rs.length) areas.push([a,rs]);
    });
    if(areas.length) blocks.push([f,areas]);
  });
  blocks.forEach(([f,areas])=>{
    const all=allRoutines(f);
    const fo=openNow(fkey(f));
    const kept=areas.reduce((n,[,rs])=>n+rs.length,0);
    out+='<section class="feat" id="f-'+f.id+'" data-open="'+fo+'">'+
      '<div class="feat-h" role="button" tabindex="0" aria-expanded="'+fo+
        '" data-k="'+fkey(f)+'">'+
      '<span class="cr">'+(fo?"\u25be":"\u25b8")+'</span><span>'+
      '<span class="ft"><h2>'+esc(f.title)+'</h2>'+
        revChip(f,"this feature is under review")+
        lectureLink(f)+
        (f.tests?f.tests.map(t=>'<span class="tag">'+esc(t)+'</span>').join(""):"")+
        '<span class="sp"><span>'+f.areas.length+' area'+(f.areas.length>1?'s':'')+'</span><span>'+
        (kept!==all.length?kept+" of "+all.length:all.length)+' routines</span></span></span>'+
      (f.summary?'<span class="sum">'+esc(f.summary)+'</span>':"")+
      deps(f)+bars(all)+'</span></div>';
    if(!fo){ out+='</section>'; return; }
    out+='<div class="feat-body">';
    const drv=[];
    f.areas.forEach(ar=>ar.routines.forEach(r=>{ if(r.driver&&drv.indexOf(r.name)<0) drv.push(r.name); }));
    if(drv.length) out+='<div class="drivers"><b>Entry points</b>'+
      drv.map(n=>'<span>'+esc(n)+'</span>').join("")+'</div>';
    if(f.modules) out+='<div class="mods">modules: <span>'+f.modules.map(esc).join("  ")+'</span></div>';
    areas.forEach(([a,rs])=>{
      const ao=openNow(akey(f,a));
      out+='<div class="area" data-open="'+ao+'">'+
        '<div class="area-h" role="button" tabindex="0" aria-expanded="'+ao+
          '" data-k="'+akey(f,a)+'">'+
        '<span class="cr">'+(ao?"\u25be":"\u25b8")+'</span><span>'+
        '<span class="at-row"><span class="an">'+a.id+'</span>'+
        '<span class="at">'+esc(a.title)+'</span>'+
        revChip(a,"this area is under review")+
        '<span class="ac">'+rs.length+(rs.length!==a.routines.length?" of "+a.routines.length:"")+
        ' routine'+(rs.length>1?'s':'')+'</span></span>'+bars(a.routines)+'</span></div>';
      if(!ao){ out+='</div>'; return; }
      if(a.note) out+='<div class="note"><b>Note</b><span>'+esc(a.note)+'</span></div>';
      out+='<div class="rows">';
      rs.forEach(r=>{
        const t="routine:"+r.file+"::"+r.name, fl=isFlagged(t);
        const dv=r.driver?' <span class="drv" title="called directly from '+esc(r.driver)+'">'+esc(r.driver)+'</span>':"";
        out+='<div class="row'+(fl?" flagged":"")+(r.driver?" drv-row":"")+'" data-t="'+esc(t)+'">'+
          '<button class="fb" aria-pressed="'+fl+'" aria-label="Flag '+esc(r.name)+'">!</button>'+
          '<span class="rn">'+esc(r.name)+dv+
            (r.todo?' <span class="todo" title="'+esc(r.todo)+'">todo</span>':"")+
            revChip(r,"under review")+'</span>'+
          '<span class="rf">'+esc(r.file)+'</span>'+
          '<span class="ph" data-p="'+esc(r.phase)+'">'+esc(r.phase)+'</span>'+
          '<span class="dep">'+(r.depth==null?"":"L"+r.depth)+'</span>'+
          (r.scope?'<span class="scope" data-s="'+esc(r.scope)+'" title="'+esc(scopeTitle(r))+'">'+esc(r.scope)+'</span>':'<span></span>')+
          (r.role?'<span class="role" data-r="'+esc(r.role)+'" title="'+esc(roleTitle(r))+'">'+esc(r.role)+'</span>':'<span></span>')+
          DIM.map(d=>d.chip(r)).join("")+
          editor(t)+'</div>';
      });
      out+='</div></div>';
    });
    out+='</div></section>';
  });
  if(!out.includes('class="feat"')) out+='<div class="empty">No routines match these filters.</div>';
  main.innerHTML=out;
  figures();
}
function qcard(q){
  const t="question:"+q.id, fl=isFlagged(t), note=noteOf(t);
  const waiting = fl && !q.r;
  return '<div class="q'+(waiting?" waiting":"")+'" data-t="'+esc(t)+'">'+
    '<button class="fb" aria-pressed="'+fl+'" aria-label="Flag this decision">!</button>'+
    '<h3>'+q.t+'<span class="qid">'+esc(q.id)+'</span>'+
      (waiting?'<span class="wt">awaiting reply</span>':"")+'</h3>'+
    '<p>'+q.b+'</p>'+
    (note?'<div class="yn"><b>You</b><span>'+esc(note)+'</span></div>':"")+
    (q.r?'<div class="rp"><b>Reply</b><span>'+q.r+'</span></div>':"")+
    editor(t)+'</div>';
}
function questions(){
  const open=QUESTIONS.filter(q=>q.status!=="answered");
  const done=QUESTIONS.filter(q=>q.status==="answered");
  const waiting=QUESTIONS.filter(q=>isFlagged("question:"+q.id)&&!q.r).length;
  let h='<summary><b>Review</b> '+open.length+' open question'+
        (open.length===1?"":"s")+' \u00b7 '+APPLIED.length+' changes applied \u00b7 '+
        (waiting?'<span class="wtc">'+waiting+' waiting on me</span>'
                :'nothing waiting on me')+'</summary>'+
        '<p>Applied since your last review: '+
        APPLIED.map(a=>'<span class="ap">'+a+'</span>').join("")+'</p>'+
        '<p class="qlede">A question stays here until it carries a written reply, '+
        'so flagging one and saving a note cannot lose it.</p>';
  open.forEach(q=>{ h+=qcard(q); });
  if(done.length){
    h+='<details class="ans"><summary>'+done.length+' answered</summary>'+
       done.map(qcard).join("")+'</details>';
  }
  /* open while it still has something for you, but a viewer who closes it
     keeps it closed -- this panel sits above the map they came to read */
  let want = open.length>0 || waiting>0;
  try{ const v=localStorage.getItem(QSKEY); if(v!==null) want = v==="1"; }catch(e){}
  return '<details class="qs"'+(want?" open":"")+'>'+h+'</details>';
}

function editor(t){
  if(!isFlagged(t)) return "";
  return '<div class="ed"><textarea placeholder="What should change?">'+esc(noteOf(t))+
         '</textarea><button class="save">Save note</button></div>';
}


/* ---------- events ---------- */
function toggleFrom(el){
  const h=el.closest("[data-k]"); if(!h) return false;
  const k=h.dataset.k;
  /* a filter forces everything that still matches open, so that narrowing is
     visible on a collapsed page. Closing one by hand then applies to this
     filter only: the remembered state is the one the page returns to. */
  if(filtering()) shut.has(k)?shut.delete(k):shut.add(k);
  else setOpen(k,!opened.has(k));
  render();
  return true;
}
document.addEventListener("click",async e=>{
  const fb=e.target.closest(".fb");
  if(fb){
    const host=fb.closest("[data-t]"), t=host.dataset.t, now=!isFlagged(t);
    await saveReview(t, now?"flag":"ok", noteOf(t));
    render();
    return;
  }
  const sv=e.target.closest(".save");
  if(sv){
    const host=sv.closest("[data-t]"), t=host.dataset.t;
    const ta=host.querySelector("textarea");
    await saveReview(t,"flag",ta.value);
    const tag=document.createElement("span");
    tag.className="saved"; tag.textContent="Saved";
    sv.after(tag); setTimeout(()=>tag.remove(),1600);
    return;
  }
  if(e.target.closest("a")) return;          /* lecture links */
  toggleFrom(e.target);
});
document.addEventListener("toggle",e=>{
  if(e.target.classList&&e.target.classList.contains("qs")){
    try{ localStorage.setItem(QSKEY, e.target.open?"1":"0"); }catch(err){}
  }
},true);
document.addEventListener("keydown",e=>{
  if(e.key!=="Enter"&&e.key!==" ") return;
  const h=e.target.closest&&e.target.closest(".feat-h,.area-h");
  if(!h) return;
  e.preventDefault(); toggleFrom(h);
});
function refilter(){ if(!filtering()) shut.clear(); render(); }

/* the test picker: 41 entries, grouped by the directory they live in */
function testPicker(){
  const sel=document.getElementById("testsel");
  if(!sel || !TM.names.length){
    const box=document.getElementById("testf"); if(box) box.hidden=true;
    return;
  }
  const byDir={};
  TM.names.forEach((n,i)=>{
    const p=TM.paths[i]||n, cut=p.lastIndexOf("/");
    const dir=cut<0?"":p.slice(0,cut), leaf=cut<0?p:p.slice(cut+1);
    (byDir[dir]=byDir[dir]||[]).push([n,leaf]);
  });
  Object.keys(byDir).sort().forEach(dir=>{
    const g=document.createElement("optgroup"); g.label=dir||"tests";
    byDir[dir].sort((a,b)=>a[1].localeCompare(b[1])).forEach(([n,leaf])=>{
      const o=document.createElement("option"); o.value=n; o.textContent=leaf;
      g.appendChild(o);
    });
    sel.appendChild(g);
  });
  sel.addEventListener("change",e=>{
    filt.test=e.target.value;
    document.getElementById("testf").dataset.on=String(!!filt.test);
    refilter();
  });
}
document.getElementById("q").addEventListener("input",e=>{
  filt.q=e.target.value.trim().toLowerCase(); refilter();
});
[["ompf","omp"],["covf","cov"],["phasef","phase"],["viewf","view"],["scopef","scope"]].forEach(([id,key])=>{
  document.getElementById(id).addEventListener("click",e=>{
    const b=e.target.closest("button"); if(!b) return;
    filt[key]=b.dataset.v;
    [...e.currentTarget.children].forEach(c=>c.setAttribute("aria-pressed",String(c===b)));
    refilter();
  });
});
document.getElementById("expf").addEventListener("click",e=>{
  const b=e.target.closest("button"); if(!b) return;
  [...e.currentTarget.children].forEach(c=>c.setAttribute("aria-pressed",String(c===b)));
  opened.clear(); shut.clear();
  if(b.dataset.v!=="none"){
    DATA.features.forEach(f=>{
      opened.add(fkey(f));
      if(b.dataset.v==="all") f.areas.forEach(a=>opened.add(akey(f,a)));
    });
  }
  saveOpen(); render();
});

/* a #f-<id> link must open the feature it points at, not scroll to a closed one */
function openFromHash(scroll){
  const m=/^#f-(.+)$/.exec(location.hash); if(!m) return;
  const f=DATA.features.find(x=>x.id===decodeURIComponent(m[1])); if(!f) return;
  if(!opened.has(fkey(f))){ setOpen(fkey(f),true); render(); }
  if(scroll){ const el=document.getElementById("f-"+f.id);
              if(el) el.scrollIntoView({block:"start"}); }
}
window.addEventListener("hashchange",()=>openFromHash(true));

/* ---------- boot ---------- */
testPicker();
rail();
render();
openFromHash(true);
if(window.claude && window.claude.use){
  claude.use("db").then(x=>{
    db=x;
    if(!db){ dbMsg("Shared flag storage is unavailable in this view &mdash; flags stay in this browser only."); return; }
    db.collection("review").onSnapshot(snap=>{
      const next=Object.create(null);
      snap.docs.forEach(d=>{ const v=d.data(); if(v&&v.target) next[v.target]=v; });
      reviews=next; render();
    },err=>{ dbMsg("Live sync stopped ("+err.code+"). Reload to resume."); });
  }).catch(()=>{});
}
/* the legend only shows the dimensions that have data */
document.querySelectorAll(".lgroup").forEach(g=>{
  g.hidden = !DIM.some(d=>d.key===g.dataset.dim);
});
</script>
