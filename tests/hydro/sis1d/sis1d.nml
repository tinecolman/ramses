&RUN_PARAMS
hydro=.true.
poisson=.true.
ncontrol=10
nrestart=0
nsubcycle=10*1
nremap=20
verbose=.false.
/

&AMR_PARAMS
levelmin=9
levelmax=15
ngridtot=300000
nexpand=20*6
boxlen=1.0
/

&REFINE_PARAMS
interpol_var=1
interpol_type=0
mass_sph=2.589968766357625d-09 !c.u., ( 5.75754077116723e-07 Msun)
m_refine=1024,512,256,85.3,28.4,9.48,2.37,0.6
jeans_refine=8,8,8
/

&HYDRO_PARAMS
gamma=1.6667
courant_factor=0.8
scheme='muscl'
slope_type=1
riemann='hllc'
pressure_fix=.true.
beta_fix=0.5
/

&POISSON_PARAMS
gravity_type=0
/

&INIT_PARAMS
condinit_kind='SIS'
/

&OUTPUT_PARAMS
delta_tout=0.001
tend=0.04
output_to_log=.false.
/

&UNITS_PARAMS
units_density=1.50492957435d-20
units_time=3.1556926d13
units_length=3.0857d18
/

&COOLING_PARAMS
cooling=.true.
barotropic_eos=.true.
barotropic_eos_form='2nd_collapse'
polytrope_rho=3.866301516d-15,3.866301516d-10,3.866301516d-5
polytrope_index=0.4,-0.3,0.56667
T_eos=10d0
mu_gas=2.37d0
/
