&RUN_PARAMS
hydro=.true.
poisson=.true.
clumpfind=.true.
sink=.true.
pic=.true.
rt=.false.
ncontrol=1
nrestart=0
nsubcycle=10*1
nremap=20
verbose=.false.
/

&AMR_PARAMS
levelmin=6
levelmax=13
ngridtot=3000000
nparttot=10000
nexpand=20*6
boxlen=.5
/

&REFINE_PARAMS
interpol_var=1
interpol_type=0
mass_sph=2.589968766357625d-09 !c.u., ( 5.75754077116723e-07 Msun)
m_refine=1024,512,256,85.3,28.4,9.48,2.37,0.6
jeans_refine=8,8,8
sink_refine=.true.
/

&CLUMPFIND_PARAMS
ivar_clump=1
rho_clfind=5d-14 !g/cm3
clinfo=.true.
/

&SINK_PARAMS
create_sinks=.true.
accretion_scheme='bondi'
clump_core=.true.
rho_sink= 2.8d-12 !g/cm3
mass_sink_seed= 0.000006 !Msun
merging_timescale=1000 !yr (fixed)
/

&HYDRO_PARAMS
gamma=1.6667
courant_factor=0.8
scheme='muscl'
slope_type=1
riemann='hllc'
pressure_fix=.true.
beta_fix=0.5
/

&POISSON_PARAMS
gravity_type=0
/

&INIT_PARAMS
condinit_kind='SIS'
/

&OUTPUT_PARAMS
noutput=1
tout=0.01
/

&UNITS_PARAMS
units_density=1.50492957435d-20
units_time=3.1556926d13
units_length=3.0857d18
/

&COOLING_PARAMS
cooling=.true.
barotropic_eos=.true.
barotropic_eos_form='2nd_collapse'
polytrope_rho=3.866301516d-15,3.866301516d-10,3.866301516d-5
polytrope_index=0.4,-0.3,0.56667
T_eos=10d0
mu_gas=2.37d0
/
